{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenTracker",
  "version": "0.1.0",
  "identifier": "com.tokentracker.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TokenTracker",
        "width": 340,
        "height": 640,
        "resizable": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBQUU5MDM3RTVDRjMyNUYKUldSZk1zL2xONUN1U3JsOWVQRFlGS1J1YlNHVHI5dE1nelBkNnRuZFpVU3FwYVczMld0V1NtaHQK",
      "endpoints": [
        "https://raw.githubusercontent.com/avedevelop/TokenTracker/main/windows/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
